    <string name="permissions_title">Permissions</string>
    <string name="permissions_intro_warning">Some alarm permissions are missing. Alarms may not fire reliably until you grant them.</string>
    <string name="permissions_intro_ok">All required permissions are granted. Your alarms will fire on time.</string>
